# ================= TELEGRAM BOT CREDENTIALS ================= #
# Bot Token from https://t.me/BotFather
BOT_TOKEN=1234567890:ABCDefghIJKlmnoPQRstuvWXyz

# API ID & API HASH from https://my.telegram.org
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Admin Telegram User ID (Numeric ID, e.g. from @userinfobot)
ADMIN_ID=123456789

# ================= OPTIONAL FEATURES ================= #
# Force Subscribe Channel Username (without @) or Channel ID (e.g. -100xxxxxxxxxx)
# Leave empty if you don't want force subscribe
FORCE_SUB_CHANNEL=

# MongoDB Atlas Connection URI (Free 512MB M0 Cluster from mongodb.com)
# Recommended for cloud hosting so data is not wiped on restarts.
# Leave empty to use local SQLite database fallback.
MONGO_URI=
DB_NAME=telegram_downloader_bot

# Port for Keep-Alive Web Server (Default 8080)
PORT=8080
